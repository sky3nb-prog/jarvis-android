<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_orb" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/widget_orb"
        android:scaleType="fitCenter" android:contentDescription="Vector" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="6dp">
        <TextClock android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFD678" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_l1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#F3E6CF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:text="VECTOR" />
        <TextView android:id="@+id/w_l2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#B8A283" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:text="" />
    </LinearLayout>
    <ImageView android:id="@+id/w_mic" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp"
        android:background="@drawable/widget_mic" android:src="@android:drawable/ic_btn_speak_now" android:contentDescription="Mit Vector reden" />
</LinearLayout>
